    "@typescript-eslint/parser": "^8.60.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dprint": "latest",
    "esbuild-loader": "^4.4.3",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.2",
